# Copy this file to .env and fill it in. NEVER commit .env to git.
# Generate the first three values with:  python -m installer.make_secrets

MCSC_ADMIN_USERNAME=admin
# PBKDF2 hash of your dashboard password. Not the password itself.
MCSC_ADMIN_PASSWORD_HASH=
# Long-lived token for scripts. Optional; leave blank if you only sign in via the dashboard.
MCSC_API_TOKEN=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
MCSC_DISCORD_WEBHOOK=

# Email: the SMTP host, port and addresses go in config/config.yaml.
# Only the credentials belong here. For Gmail use an App Password, not your main password.
MCSC_SMTP_USERNAME=
MCSC_SMTP_PASSWORD=

# Optional overrides for config.yaml values:
# MCSC_HOST=100.101.102.103
# MCSC_PORT=8765
# MCSC_SERVER_DIR=C:\path\to\Minecraft Server
# MCSC_DATA_DIR=
